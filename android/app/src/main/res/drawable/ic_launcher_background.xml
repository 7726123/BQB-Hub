<?xml version="1.0" encoding="utf-8"?>
<!-- 品牌背景层（自适应图标）：深底 + 右下暖光。字形在前景层 mipmap/ic_launcher_foreground。
     风格来源：新 logo（书法 BQB，深底金线），见交接文档 §13.169。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FF0F0F13" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.86"
                android:centerY="0.96"
                android:gradientRadius="150dp"
                android:startColor="#CCFFB86C"
                android:endColor="#00FFB86C" />
        </shape>
    </item>
</layer-list>
