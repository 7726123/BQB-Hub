<?xml version="1.0" encoding="UTF-8"?>
<!--
  BQB Hub 社区服务端 · Java 版（换栈第一步：只换语言，保留 SQLite）
  契约：与 server/（Node 版）共用同一套验收测试 —— 见 server/tests/CONTRACT.md
  运行：java -jar target/bqbhub-server-java-0.1.0.jar（环境变量与 Node 版同名，见 README）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>bqbhub</groupId>
  <artifactId>bqbhub-server-java</artifactId>
  <version>0.1.0</version>
  <name>bqbhub-server-java</name>
  <description>BQB Hub 社区服务端（Spring Boot + SQLite；与 Node 版共用契约测试）</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
    <bcprov.version>1.78.1</bcprov.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- JdbcTemplate + HikariCP：SQL 逐条直译，不引 ORM（MyBatis-Plus 以后要 CRUD 代码生成时再上） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>
    <!-- 发信（验证码）：对应 Node 版的 nodemailer；未配置 SMTP 时抛 NotConfigured → 500 + 同款文案 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- 口令派生：scrypt（参数与 Node 版逐字节一致，见 server/tools/scrypt-parity） -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bcprov.version}</version>
    </dependency>
    <!-- PEM 解析（TLS 私钥：PKCS#8 与 PKCS#1 都认，见 TlsConfig）——PEMParser 在 bcpkix 里 -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>${bcprov.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>bqbhub-server-java</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
